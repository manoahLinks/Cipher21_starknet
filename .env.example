# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never commit a private key, a viewing key, or any other secret.

# ─── RPC ─────────────────────────────────────────────────────────────────────
# A free Alchemy key works for both networks: https://www.alchemy.com
ALCHEMY_KEY=
STARKNET_SEPOLIA_RPC=https://api.cartridge.gg/x/starknet/sepolia
STARKNET_MAINNET_RPC=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_8/${ALCHEMY_KEY}

# ─── Deployer account (Sepolia) ──────────────────────────────────────────────
# Used by scripts/ to declare and deploy Cipher21 contracts. This is an ordinary
# Starknet account key, NOT a STRK20 viewing key — the dapp never touches one of
# those. Keep it here, keep it out of git, and use a throwaway account.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ─── Deployed contracts (filled in as milestones land) ───────────────────────
CIPHER21_TABLE_SEPOLIA=
CIPHER21_ANONYMIZER_SEPOLIA=
